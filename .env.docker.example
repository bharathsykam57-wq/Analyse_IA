# Docker Compose local full-stack defaults

POSTGRES_DB=analyseia
POSTGRES_USER=analyseia
POSTGRES_PASSWORD=analyseia
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434

DATABASE_URL=postgresql+psycopg2://analyseia:analyseia@postgres:5432/analyseia
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-for-non-local-env
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
OPS_API_TOKEN=ops-dev-token

LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_REQUIRED=false

UPLOAD_DIR=uploads
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
