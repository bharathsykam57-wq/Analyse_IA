        self.print_summary()
        
        return all_pass
    
    def print_summary(self):
        """Print test summary"""
        logger.info("\n" + "=" * 60)
        logger.info("TEST SUMMARY")
        logger.info("=" * 60)
        
        for test_name, result in self.results:
            status_symbol = "✓" if result == "PASS" else "✗" if "FAIL" in result else "⊘"
