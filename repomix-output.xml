    if path.suffix.lower() != ".csv":
        logger.error(f"Not a CSV file: {dataset_path}")
        return {"success": False, "error": f"Le fichier doit être un CSV: {dataset_path}"}

    # STAGE 1/5 — LOAD DATASET
